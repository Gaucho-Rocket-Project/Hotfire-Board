/ {
 chosen {
  zephyr,crc = &crc;
  zephyr,entropy = &rng;
  zephyr,flash-controller = &flash;
 };

 cpus {
  #address-cells = <1>;
  #size-cells = <0>;

  cpu0: cpu@0 {
   compatible = "arm,cortex-m4f";
   reg = <0>;
   device_type = "cpu";
   cpu-power-states = <&stop0 &stop1 &stop2>;
  };

  power-states {
   stop0: state0 {
    compatible = "zephyr,power-state";
    power-state-name = "suspend-to-idle";
    substate-id = <1>;
    min-residency-us = <500>;
   };

   stop1: state1 {
    compatible = "zephyr,power-state";
    power-state-name = "suspend-to-idle";
    substate-id = <2>;
    min-residency-us = <700>;
   };

   stop2: state2 {
    compatible = "zephyr,power-state";
    power-state-name = "suspend-to-idle";
    substate-id = <3>;
    min-residency-us = <1000>;
   };
  };
 };

 clocks {
  clk_hse: clk-hse {
   compatible = "st,stm32-hse-clock";
   #clock-cells = <0>;
   status = "disabled";
  };

  clk_hsi: clk-hsi {
   compatible = "fixed-clock";
   #clock-cells = <0>;
   clock-frequency = <(((16) * 1000) * 1000)>;
   status = "disabled";
  };

  clk_msi: clk-msi {
   compatible = "st,stm32-msi-clock";
   #clock-cells = <0>;
   msi-range = <6>;
   status = "disabled";
  };

  clk_lse: clk-lse {
   compatible = "st,stm32-lse-clock";
   #clock-cells = <0>;
   clock-frequency = <32768>;
   driving-capability = <0>;
   status = "disabled";
  };

  clk_lsi: clk-lsi {
   compatible = "fixed-clock";
   #clock-cells = <0>;
   clock-frequency = <((32) * 1000)>;
   status = "disabled";
  };

  pll: pll {
   compatible = "st,stm32l4-pll-clock";
   #clock-cells = <0>;
   status = "disabled";
  };

  pllsai1: pllsai1 {
   compatible = "st,stm32l4-pll-clock";
   #clock-cells = <0>;
   status = "disabled";
  };
 };

 mcos {
  mco1: mco1 {
   compatible = "st,stm32-clock-mco";
   clock-names = "clksel";
   status = "disabled";
  };
 };

 soc {
  timers2: timers@40000000 {
   compatible = "st,stm32-timers";
   reg = <0x40000000 0x400>;
   clocks = <&rcc (0x058) (1 << 0)>,
     <&rcc ((((((0x003 + 1) + 1) + 1) + 1) + 1) + 1) 0xFF>;
   resets = <&rctl (((0x38) << 5U) | (0))>;
   interrupts = <28 0>;
   interrupt-names = "global";
   st,prescaler = <0>;
   status = "disabled";

   pwm {
    compatible = "st,stm32-pwm";
    #pwm-cells = <3>;
    status = "disabled";
   };

   counter {
    compatible = "st,stm32-counter";
    status = "disabled";
   };

   qdec {
    compatible = "st,stm32-qdec";
    st,input-filter-level = <0>;
    status = "disabled";
   };
  };

  timers6: timers@40001000 {
   compatible = "st,stm32-timers";
   reg = <0x40001000 0x400>;
   clocks = <&rcc (0x058) (1 << 4)>,
     <&rcc ((((((0x003 + 1) + 1) + 1) + 1) + 1) + 1) 0xFF>;
   resets = <&rctl (((0x38) << 5U) | (4))>;
   interrupts = <54 0>;
   interrupt-names = "global";
   st,prescaler = <0>;
   status = "disabled";

   counter {
    compatible = "st,stm32-counter";
    status = "disabled";
   };
  };

  rtc: rtc@40002800 {
   compatible = "st,stm32-rtc";
   reg = <0x40002800 0x400>;
   interrupts = <41 0>;
   clocks = <&rcc (0x058) (1 << 28)>;
   prescaler = <32768>;
   alarms-count = <2>;
   alrm-exti-line = <18>;
   status = "disabled";
  };

  wwdg: watchdog@40002c00 {
   compatible = "st,stm32-window-watchdog";
   reg = <0x40002c00 0x400>;
   clocks = <&rcc (0x058) (1 << 11)>;
   interrupts = <0 0>;
   status = "disabled";
  };

  iwdg: watchdog@40003000 {
   compatible = "st,stm32-watchdog";
   reg = <0x40003000 0x400>;
   status = "disabled";
  };

  usart2: serial@40004400 {
   compatible = "st,stm32-usart", "st,stm32-uart";
   reg = <0x40004400 0x400>;
   clocks = <&rcc (0x058) (1 << 17)>;
   resets = <&rctl (((0x38) << 5U) | (17))>;
   interrupts = <38 0>;
   status = "disabled";
  };

  i2c1: i2c@40005400 {
   compatible = "st,stm32-i2c-v2";
   reg = <0x40005400 0x400>;
   clock-frequency = <100000>;
   #address-cells = <1>;
   #size-cells = <0>;
   clocks = <&rcc (0x058) (1 << 21)>;
   interrupts = <31 0>, <32 0>;
   interrupt-names = "event", "error";
   status = "disabled";
  };

  i2c3: i2c@40005c00 {
   compatible = "st,stm32-i2c-v2";
   reg = <0x40005c00 0x400>;
   clock-frequency = <100000>;
   #address-cells = <1>;
   #size-cells = <0>;
   clocks = <&rcc (0x058) (1 << 23)>;
   interrupts = <72 0>, <73 0>;
   interrupt-names = "event", "error";
   status = "disabled";
  };

  pwr: power@40007000 {
   compatible = "st,stm32-pwr";
   reg = <0x40007000 0x400>;

   wakeup-controller {
    compatible = "st,stm32-pwr-wkupctrl";
    #address-cells = <1>;
    #size-cells = <0>;

    st,max-wkup-line-idx = <5>;
    st,has-pwr-full-pupd;
    status = "disabled";

    wkup@1 {
     reg = <0x1>;
    };

    wkup@2 {
     reg = <0x2>;
    };

    wkup@3 {
     reg = <0x3>;
    };

    wkup@4 {
     reg = <0x4>;
    };

    wkup@5 {
     reg = <0x5>;
    };
   };
  };

  lptim1: timers@40007c00 {
   compatible = "st,stm32-lptim";
   reg = <0x40007c00 0x400>;
   clocks = <&rcc (0x058) (1 << 31)>;
   resets = <&rctl (((0x38) << 5U) | (31))>;
   #address-cells = <1>;
   #size-cells = <0>;
   interrupts = <65 0>;
   interrupt-names = "wakeup";
   status = "disabled";
  };

  lpuart1: serial@40008000 {
   compatible = "st,stm32-lpuart", "st,stm32-uart";
   reg = <0x40008000 0x400>;
   clocks = <&rcc (0x05c) (1 << 0)>;
   resets = <&rctl (((0x3C) << 5U) | (0))>;
   interrupts = <70 0>;
   status = "disabled";
  };

  lptim2: timers@40009400 {
   compatible = "st,stm32-lptim";
   reg = <0x40009400 0x400>;
   #address-cells = <1>;
   #size-cells = <0>;
   clocks = <&rcc (0x05c) (1 << 5)>;
   resets = <&rctl (((0x3C) << 5U) | (5))>;
   interrupts = <66 0>;
   interrupt-names = "wakeup";
   status = "disabled";
  };

  exti: interrupt-controller@40010400 {
   compatible = "st,stm32-exti";
   reg = <0x40010400 0x400>;
   interrupt-controller;
   #interrupt-cells = <1>;
   #address-cells = <0>;
   clocks = <&rcc (0x060) (1 << 0)>;
   num-lines = <64>;
   interrupts = <6 0>, <7 0>, <8 0>, <9 0>,
         <10 0>, <23 0>, <40 0>;
   interrupt-names = "line0", "line1", "line2", "line3",
       "line4", "line5-9", "line10-15";
   line-ranges = <0 1>, <1 1>, <2 1>, <3 1>,
          <4 1>, <5 5>, <10 6>;
  };

  timers1: timers@40012c00 {
   compatible = "st,stm32-timers";
   reg = <0x40012c00 0x400>;
   clocks = <&rcc (0x060) (1 << 11)>,
     <&rcc (((((((0x003 + 1) + 1) + 1) + 1) + 1) + 1) + 1) 0xFF>;
   resets = <&rctl (((0x40) << 5U) | (11))>;
   interrupts = <24 0>, <25 0>, <26 0>, <27 0>;
   interrupt-names = "brk", "up", "trgcom", "cc";
   st,prescaler = <0>;
   status = "disabled";

   pwm {
    compatible = "st,stm32-pwm";
    #pwm-cells = <3>;
    status = "disabled";
   };

   counter {
    compatible = "st,stm32-counter";
    status = "disabled";
   };

   qdec {
    compatible = "st,stm32-qdec";
    st,input-filter-level = <0>;
    status = "disabled";
   };
  };

  spi1: spi@40013000 {
   compatible = "st,stm32-spi-fifo", "st,stm32-spi";
   reg = <0x40013000 0x400>;
   #address-cells = <1>;
   #size-cells = <0>;
   interrupts = <35 0>;
   clocks = <&rcc (0x060) (1 << 12)>;
   st,spi-data-width = "full-4-to-16-bit";
   status = "disabled";
  };

  usart1: serial@40013800 {
   compatible = "st,stm32-usart", "st,stm32-uart";
   reg = <0x40013800 0x400>;
   clocks = <&rcc (0x060) (1 << 14)>;
   resets = <&rctl (((0x40) << 5U) | (14))>;
   interrupts = <37 0>;
   status = "disabled";
  };

  timers15: timers@40014000 {
   compatible = "st,stm32-timers";
   reg = <0x40014000 0x400>;
   clocks = <&rcc (0x060) (1 << 16)>,
     <&rcc (((((((0x003 + 1) + 1) + 1) + 1) + 1) + 1) + 1) 0xFF>;
   resets = <&rctl (((0x40) << 5U) | (16))>;
   interrupts = <24 0>;
   interrupt-names = "global";
   st,prescaler = <0>;
   status = "disabled";

   pwm {
    compatible = "st,stm32-pwm";
    #pwm-cells = <3>;
    status = "disabled";
   };

   counter {
    compatible = "st,stm32-counter";
    status = "disabled";
   };
  };

  timers16: timers@40014400 {
   compatible = "st,stm32-timers";
   reg = <0x40014400 0x400>;
   clocks = <&rcc (0x060) (1 << 17)>,
     <&rcc (((((((0x003 + 1) + 1) + 1) + 1) + 1) + 1) + 1) 0xFF>;
   resets = <&rctl (((0x40) << 5U) | (17))>;
   interrupts = <25 0>;
   interrupt-names = "global";
   st,prescaler = <0>;
   status = "disabled";

   pwm {
    compatible = "st,stm32-pwm";
    #pwm-cells = <3>;
    status = "disabled";
   };

   counter {
    compatible = "st,stm32-counter";
    status = "disabled";
   };
  };

  dma1: dma@40020000 {
   compatible = "st,stm32-dma-v2";
   reg = <0x40020000 0x400>;
   #dma-cells = <3>;
   interrupts = <11 0>, <12 0>, <13 0>, <14 0>, <15 0>, <16 0>, <17 0>;
   clocks = <&rcc (0x048) (1 << 0)>;
   dma-requests = <7>;
   status = "disabled";
  };

  dma2: dma@40020400 {
   compatible = "st,stm32-dma-v2";
   reg = <0x40020400 0x400>;
   #dma-cells = <3>;
   interrupts = <56 0>, <57 0>, <58 0>, <59 0>, <60 0>, <68 0>, <69 0>;
   clocks = <&rcc (0x048) (1 << 1)>;
   dma-requests = <7>;
   status = "disabled";
  };

  rcc: rcc@40021000 {
   compatible = "st,stm32-rcc";
   reg = <0x40021000 0x400>;
   #clock-cells = <2>;

   rctl: reset-controller {
    compatible = "st,stm32-rcc-rctl";
    #reset-cells = <1>;
   };
  };

  flash: flash-controller@40022000 {
   compatible = "st,stm32-flash-controller", "st,stm32l4-flash-controller";
   reg = <0x40022000 0x400>;
   ranges;
   interrupts = <4 0>;
   clocks = <&rcc (0x048) (1 << 8)>;

   #address-cells = <1>;
   #size-cells = <1>;

   flash0: flash@8000000 {
    compatible = "st,stm32-nv-flash", "soc-nv-flash";
    #address-cells = <1>;
    #size-cells = <1>;
    write-block-size = <8>;
    erase-block-size = <2048>;

    max-erase-time = <25>;
   };

   st_nvm_user_otp: flash@1fff7000 {
    compatible = "st,stm32-nvm-otp";
    reg = <0x1fff7000 ((1) * 1024)>;
    status = "disabled";
   };


   flash@1fff7500 {
    compatible = "st,stm32-nvm-otp";
    reg = <0x1fff7500 768>;

    nvmem-layout {
     compatible = "fixed-layout";
     #address-cells = <1>;
     #size-cells = <1>;

     ts_cal1_otp: ts-cal1@a8 {
      reg = <0xa8 0x2>;
      #nvmem-cell-cells = <0>;
      read-only;
     };

     vrefint_otp: vrefint@aa {
      reg = <0xaa 0x2>;
      #nvmem-cell-cells = <0>;
      read-only;
     };

     ts_cal2_otp: ts-cal2@ca {
      reg = <0xca 0x2>;
      #nvmem-cell-cells = <0>;
      read-only;
     };
    };
   };
  };

  crc: crc@40023000 {
   compatible = "st,stm32-crc";
   reg = <0x40023000 0x400>;
   clocks = <&rcc (0x048) (1 << 12)>;
   resets = <&rctl (((0x28) << 5U) | (12))>;
   status = "disabled";
  };

  pinctrl: pin-controller@48000000 {
   compatible = "st,stm32-pinctrl";
   reg = <0x48000000 0x2000>;
   ranges;
   #address-cells = <1>;
   #size-cells = <1>;

   gpioa: gpio@48000000 {
    compatible = "st,stm32-gpio";
    reg = <0x48000000 0x400>;
    gpio-controller;
    #gpio-cells = <2>;
    clocks = <&rcc (0x04c) (1 << 0)>;
   };

   gpiob: gpio@48000400 {
    compatible = "st,stm32-gpio";
    reg = <0x48000400 0x400>;
