# 1 "/Users/jacob/zephyrproject/zephyr/include/zephyr/dt-bindings/gpio/arduino-header-r3.h" 1 3 4
# 8 "/Users/jacob/zephyrproject/zephyr/boards/st/nucleo_l496zg/arduino_r3_connector.dtsi" 2

/ {
 arduino_header: connector {
  compatible = "arduino-header-r3";
  #gpio-cells = <2>;
  gpio-map-mask = <0xffffffff 0xffffffc0>;
  gpio-map-pass-thru = <0 0x3f>;
  gpio-map = <0 0 &gpioa 3 0>,
      <1 0 &gpioc 0 0>,
      <2 0 &gpioc 3 0>,
      <3 0 &gpioc 1 0>,
      <4 0 &gpioc 4 0>,
      <5 0 &gpioc 5 0>,
      <6 0 &gpiod 9 0>,
      <7 0 &gpiod 8 0>,
      <8 0 &gpiof 15 0>,
      <9 0 &gpioe 13 0>,
      <10 0 &gpiof 14 0>,
      <11 0 &gpioe 11 0>,
      <12 0 &gpioe 9 0>,
      <13 0 &gpiof 13 0>,
      <14 0 &gpiof 12 0>,
      <15 0 &gpiod 15 0>,
      <16 0 &gpiod 14 0>,
      <17 0 &gpioa 7 0>,
      <18 0 &gpioa 6 0>,
      <19 0 &gpioa 5 0>,
      <20 0 &gpiob 9 0>,
      <21 0 &gpiob 8 0>;
 };
};

arduino_i2c: &i2c1 {};

arduino_spi: &spi1 {};

arduino_serial: &lpuart1 {};
# 11 "/Users/jacob/zephyrproject/zephyr/boards/st/nucleo_l496zg/nucleo_l496zg.dts" 2
# 1 "/Users/jacob/zephyrproject/zephyr/include/zephyr/dt-bindings/input/input-event-codes.h" 1 3 4
# 12 "/Users/jacob/zephyrproject/zephyr/boards/st/nucleo_l496zg/nucleo_l496zg.dts" 2

/ {
 compatible = "st,stm32l496zg-nucleo";
 model = "STMicroelectronics STM32L496ZG-NUCLEO board";

 chosen {
  zephyr,console = &lpuart1;
  zephyr,shell-uart = &lpuart1;
  zephyr,sram = &sram0;
  zephyr,flash = &flash0;
 };

 leds: leds {
  compatible = "gpio-leds";

  green_led_1: led_1 {
   gpios = <&gpioc 7 (0 << 0)>;
   label = "User LD1";
  };

  blue_led_2: led_2 {
   gpios = <&gpiob 7 (0 << 0)>;
   label = "User LD2";
  };

  red_led_3: led_3 {
   gpios = <&gpiob 14 (0 << 0)>;
   label = "User LD3";
  };
 };

 pwmleds {
  compatible = "pwm-leds";

  red_pwm_led: red_pwm_led {
   pwms = <&pwm15 1 (((20) * 1000UL) * 1000UL) (0 << 0)>;
  };
 };

 gpio_keys {
  compatible = "gpio-keys";

  user_button: button {
   label = "User Button";
   gpios = <&gpioc 13 (0 << 0)>;
   zephyr,code = <11>;
  };
 };

 aliases {
  led0 = &green_led_1;
  led1 = &blue_led_2;
  led2 = &red_led_3;
  pwm-led0 = &red_pwm_led;
  sw0 = &user_button;
  watchdog0 = &wwdg;
 };
};

&clk_lsi {
 status = "okay";
};

&clk_hsi {
 status = "okay";
};

&clk_hsi48 {
 status = "okay";
};

&pll {
 div-m = <1>;
 mul-n = <20>;
 div-p = <7>;
 div-q = <2>;
 div-r = <4>;
 clocks = <&clk_hsi>;
 status = "okay";
};

&rcc {
 clocks = <&pll>;
 clock-frequency = <(((80) * 1000) * 1000)>;
 ahb-prescaler = <1>;
 apb1-prescaler = <1>;
 apb2-prescaler = <1>;
};

&usart2 {
 pinctrl-0 = <&usart2_tx_pd5 &usart2_rx_pd6>;
 pinctrl-names = "default";
 current-speed = <115200>;
 status = "okay";
};

&usart3 {
 pinctrl-0 = <&usart3_tx_pd8 &usart3_rx_pd9>;
 pinctrl-names = "default";
 current-speed = <115200>;
 status = "okay";
};

&lpuart1 {
 pinctrl-0 = <&lpuart1_tx_pg7 &lpuart1_rx_pg8>;
 pinctrl-names = "default";
 current-speed = <115200>;
 status = "okay";
};

zephyr_udc0: &usbotg_fs {
 pinctrl-0 = <&usb_otg_fs_dm_pa11 &usb_otg_fs_dp_pa12>;
 pinctrl-names = "default";
 status = "okay";
};

&timers1 {
 st,prescaler = <10000>;
 status = "okay";

 pwm1: pwm {
  pinctrl-0 = <&tim1_ch1_pe9
        &tim1_ch2_pe11
        &tim1_ch3_pe13>;
  pinctrl-names = "default";
  status = "okay";
 };
};

&timers2 {
 status = "okay";

 pwm2: pwm {
  pinctrl-0 = <&tim2_ch1_pa0>;
  pinctrl-names = "default";
  status = "okay";
 };
};

&timers15 {
 st,prescaler = <10000>;
 status = "okay";

 pwm15: pwm {
  pinctrl-0 = <&tim15_ch1_pb14>;
  pinctrl-names = "default";
  status = "okay";
 };
};

&i2c1 {
 pinctrl-0 = <&i2c1_scl_pb8 &i2c1_sda_pb9>;
 pinctrl-names = "default";
 scl-gpios = <&gpiob 8 (0 << 0)>;
 sda-gpios = <&gpiob 9 (0 << 0)>;
 clock-frequency = <400000>;
 status = "okay";
};

&spi1 {
 pinctrl-0 = <&spi1_sck_pa5 &spi1_miso_pa6 &spi1_mosi_pa7>;
 pinctrl-names = "default";
 cs-gpios = <&gpiod 14 ((1 << 0) | (1 << 4))>;
 status = "okay";
};

&rtc {
 clocks = <&rcc (0x058) (1 << 28)>,
   <&rcc 0x003 ((((0x90) & 0xFFFFU) << 0U) | (((8) & 0x1FU) << 16U) | ((((9) - (8)) & 0x3U) << 21U) | ((((2)) & 0xFFU) << 24U))>;
 status = "okay";
};

&wwdg {
 status = "okay";
};
# 0 "<command-line>" 2
# 1 "/Users/jacob/projects/grp/daq-module/firmware/app.overlay" 1


/ {

    leds {
        hotfire_led: hotfire_led {
            gpios = <&gpiob 1 (0 << 0)>;
            label = "Hotfire LED5 (PB1)";
        };
    };

    aliases {
        led0 = &hotfire_led;
        telemetry-uart = &usart1;
    };

    chosen {
        zephyr,shell-uart = &cdc_acm_uart0;
    };
};

&usart1 {
    pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
    pinctrl-names = "default";

    current-speed = <115200>;
    status = "okay";
};


&sdmmc1 {
    pinctrl-0 = <&sdmmc1_d0_pc8 &sdmmc1_d1_pc9
                 &sdmmc1_d2_pc10 &sdmmc1_d3_pc11
                 &sdmmc1_ck_pc12 &sdmmc1_cmd_pd2>;
    pinctrl-names = "default";
    bus-width = <4>;
    disk-name = "SD";
    status = "okay";
};


&flash0 {
    reg = <0x08000000 0x00080000>;
    ranges = <0 0x08000000 0x00080000>;
};


&usart2 { status = "disabled"; };
&usart3 { status = "disabled"; };
&lpuart1 { status = "disabled"; };
&spi1 { status = "disabled"; };
&i2c1 { status = "disabled"; };
&timers1 { status = "disabled"; };
&timers2 { status = "disabled"; };
&timers15 { status = "disabled"; };

&usbotg_fs {
    status = "okay";
};

&zephyr_udc0 {
    cdc_acm_uart0: cdc_acm_uart0 {
        compatible = "zephyr,cdc-acm-uart";
        label = "DAQ USB";
    };
};
