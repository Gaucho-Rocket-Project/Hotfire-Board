#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/dma/stm32_dma.h>

/ {
    zephyr,user {
        /* P0/J5, P1/J9, P2/J10, P3/J7. */
        io-channels = <&adc1 1>, <&adc1 2>, <&adc1 3>, <&adc1 4>;
    };
    /* Hotfire data logger: LED5 is PB1 -> R61 -> LED -> GND. */
    leds {
        hotfire_led: hotfire_led {
            gpios = <&gpiob 1 GPIO_ACTIVE_HIGH>;
            label = "Hotfire LED5 (PB1)";
        };
    };

    aliases {
        led0 = &hotfire_led;
        telemetry-uart = &usart1;
    };

    chosen {
        zephyr,shell-uart = &cdc_acm_uart0;
    };
};

&usart1 {
    /* USART1 request 2: keep DMA1 channels 4/5 free for SPI2. */
    dmas = <&dma2 6 2 (STM32_DMA_PERIPH_TX | STM32_DMA_PRIORITY_HIGH)>,
           <&dma2 7 2 (STM32_DMA_PERIPH_RX | STM32_DMA_PRIORITY_HIGH)>;
    dma-names = "tx", "rx";
    pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
    pinctrl-names = "default";

    current-speed = <115200>;
    status = "okay";
};

/* Onboard microSD: D0-D3 on PC8-PC11, CLK on PC12, CMD on PD2. */
&sdmmc1 {
    pinctrl-0 = <&sdmmc1_d0_pc8 &sdmmc1_d1_pc9
                 &sdmmc1_d2_pc10 &sdmmc1_d3_pc11
                 &sdmmc1_ck_pc12 &sdmmc1_cmd_pd2>;
    pinctrl-names = "default";
    bus-width = <4>;
    disk-name = "SD";
    /* R23 pulls SD_DET high; the socket switch grounds PC7 when inserted. */
    cd-gpios = <&gpioc 7 GPIO_ACTIVE_LOW>;
    status = "okay";
};

/* The custom board uses STM32L496RE (512 KiB), not ZG (1 MiB). */
&flash0 {
    reg = <0x08000000 0x00080000>;
    ranges = <0 0x08000000 0x00080000>;
};

/* Disable Nucleo-only peripherals/pins for this initial bring-up. */
&usart2 { status = "disabled"; };
&usart3 { status = "disabled"; };
&lpuart1 { status = "disabled"; };
&spi1 { status = "disabled"; };
&i2c1 { status = "disabled"; };
&timers1 { status = "disabled"; };
&timers2 { status = "disabled"; };
&timers15 { status = "disabled"; };

&usbotg_fs {
    status = "okay";
};

/* Hardware random IDs for independent SD log sessions. */
&rng { status = "okay"; };

&zephyr_udc0 {
    cdc_acm_uart0: cdc_acm_uart0 {
        compatible = "zephyr,cdc-acm-uart";
        label = "DAQ USB";
    };
};

/* Shared SPI bus for MAX31856 U6-U9 */
&dma1 { status = "okay"; };
&dma2 { status = "okay"; };

&spi2 {
    /* SPI2 request 1, DMA1 channels 4 (RX) and 5 (TX). */
    dmas = <&dma1 4 1 (STM32_DMA_PERIPH_RX | STM32_DMA_PRIORITY_HIGH)>,
           <&dma1 5 1 (STM32_DMA_PERIPH_TX | STM32_DMA_PRIORITY_MEDIUM)>;
    dma-names = "rx", "tx";
    pinctrl-0 = <
        &spi2_sck_pb13
        &spi2_miso_pb14
        &spi2_mosi_pb15
    >;
    pinctrl-names = "default";

    status = "okay";
};

/* 80 MHz bus / 4 = 20 MHz ADC clock; VREF+ is tied to the 3V3 rail. */
&adc123_common {
    st,adc-clock-source = "SYNC";
    st,adc-prescaler = <4>;
    vref-mv = <3300>;
    status = "okay";
};

/* Enable the factory VREFINT description used for ADC rail calibration. */
&vref { status = "okay"; };

&adc1 {
    pinctrl-0 = <&adc1_in1_pc0 &adc1_in2_pc1 &adc1_in3_pc2 &adc1_in4_pc3>;
    pinctrl-names = "default";
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;

    /* Long acquisition time for the 4.7k / 0.1uF input filters. */
    channel@1 {
        reg = <1>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 641)>;
        zephyr,resolution = <12>;
    };
    channel@2 {
        reg = <2>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 641)>;
        zephyr,resolution = <12>;
    };
    channel@3 {
        reg = <3>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 641)>;
        zephyr,resolution = <12>;
    };
    channel@4 {
        reg = <4>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 641)>;
        zephyr,resolution = <12>;
    };
};
