#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
    /* Hotfire data logger: LED5 is PB1 -> R61 -> LED -> GND. */
    leds {
        hotfire_led: hotfire_led {
            gpios = <&gpiob 1 GPIO_ACTIVE_HIGH>;
            label = "Hotfire LED5 (PB1)";
        };
    };

    aliases {
        led0 = &hotfire_led;
        telemetry-uart = &usart1;
    };

    chosen {
        zephyr,shell-uart = &cdc_acm_uart0;
    };
};

&usart1 {
    pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
    pinctrl-names = "default";

    current-speed = <115200>;
    status = "okay";
};

/* Onboard microSD: D0-D3 on PC8-PC11, CLK on PC12, CMD on PD2. */
&sdmmc1 {
    pinctrl-0 = <&sdmmc1_d0_pc8 &sdmmc1_d1_pc9
                 &sdmmc1_d2_pc10 &sdmmc1_d3_pc11
                 &sdmmc1_ck_pc12 &sdmmc1_cmd_pd2>;
    pinctrl-names = "default";
    bus-width = <4>;
    disk-name = "SD";
    status = "okay";
};

/* The custom board uses STM32L496RE (512 KiB), not ZG (1 MiB). */
&flash0 {
    reg = <0x08000000 0x00080000>;
    ranges = <0 0x08000000 0x00080000>;
};

/* Disable Nucleo-only peripherals/pins for this initial bring-up. */
&usart2 { status = "disabled"; };
&usart3 { status = "disabled"; };
&lpuart1 { status = "disabled"; };
&spi1 { status = "disabled"; };
&i2c1 { status = "disabled"; };
&timers1 { status = "disabled"; };
&timers2 { status = "disabled"; };
&timers15 { status = "disabled"; };

&usbotg_fs {
    status = "okay";
};

&zephyr_udc0 {
    cdc_acm_uart0: cdc_acm_uart0 {
        compatible = "zephyr,cdc-acm-uart";
        label = "DAQ USB";
    };
};
